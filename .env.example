# Copy to `.env.local` and fill in.
# Vite only exposes variables prefixed with VITE_ to the browser.

# POST endpoint that receives contact form submissions as JSON
# ({ name, email, message }). Until this is set, the contact form
# will tell visitors that message delivery is not configured rather
# than falsely reporting success.
VITE_CONTACT_ENDPOINT=

# Base URL of the Aylo API. The pricing section reads its plans, prices and
# feature bullets from `<base>/api/v1/payment/pricing-packages/` — the same
# rows the app and Payme bill against — so nothing on the page is a price
# typed into this repo. Unlike the contact endpoint this has a working
# default (https://api.aylo.uz); set it only to point a local or staging
# build at a different API.
VITE_API_BASE_URL=
